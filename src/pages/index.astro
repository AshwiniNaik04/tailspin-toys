---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { getAllCategories } from '../lib/categories';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

const database = getDatabase();
const [games, categories, publishers] = await Promise.all([
  getAllGames(database),
  getAllCategories(database),
  getAllPublishers(database),
]);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h2 class="text-2xl font-medium text-slate-100">Featured Games</h2>
          <p class="mt-1 text-sm text-slate-400" data-testid="filter-results" role="status" aria-live="polite">
            Showing {games.length} of {games.length} games
          </p>
        </div>
        <form class="rounded-xl border border-slate-700 bg-slate-800/60 p-4 shadow-lg" data-testid="game-filters">
          <div class="flex flex-col gap-4 lg:flex-row lg:items-end">
            <fieldset>
              <legend class="mb-2 text-sm font-medium text-slate-200">Category</legend>
              <div class="flex flex-wrap gap-x-4 gap-y-2">
                {categories.map((category) => (
                  <label class="flex items-center gap-2 text-sm text-slate-300" for={`category-${category.id}`}>
                    <input
                      id={`category-${category.id}`}
                      type="checkbox"
                      name="category"
                      value={category.id}
                      class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-slate-800"
                      data-testid={`category-filter-${category.id}`}
                    />
                    {category.name}
                  </label>
                ))}
              </div>
            </fieldset>
            <div class="min-w-48">
              <label class="mb-2 block text-sm font-medium text-slate-200" for="publisher-filter">Publisher</label>
              <select
                id="publisher-filter"
                name="publisher"
                class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-sm text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                data-testid="publisher-filter"
              >
                <option value="">All publishers</option>
                {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
              </select>
            </div>
            <button
              type="reset"
              class="rounded-lg border border-slate-600 px-3 py-2 text-sm font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              data-testid="clear-filters"
            >
              Clear filters
            </button>
          </div>
        </form>
      </div>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      )}
      <div class="hidden" data-testid="filtered-empty-state">
        <EmptyState text="No games match those filters." />
      </div>
    </div>
  </div>
</Layout>

<script>
  const filterForm = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const gameCards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
  const results = document.querySelector<HTMLElement>('[data-testid="filter-results"]');
  const filteredEmptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty-state"]');

  if (filterForm && results && filteredEmptyState) {
    const applyFilters = (): void => {
      const selectedCategories = new Set(
        Array.from(filterForm.querySelectorAll<HTMLInputElement>('input[name="category"]:checked'))
          .map((input) => input.value),
      );
      const selectedPublisher = filterForm.querySelector<HTMLSelectElement>('select[name="publisher"]')?.value ?? '';
      let visibleCount = 0;

      gameCards.forEach((card) => {
        const categoryMatches = selectedCategories.size === 0 || selectedCategories.has(card.dataset.categoryId ?? '');
        const publisherMatches = selectedPublisher === '' || card.dataset.publisherId === selectedPublisher;
        const isVisible = categoryMatches && publisherMatches;
        card.hidden = !isVisible;
        if (isVisible) visibleCount += 1;
      });

      results.textContent = `Showing ${visibleCount} of ${gameCards.length} games`;
      filteredEmptyState.hidden = visibleCount !== 0;
    };

    filterForm.addEventListener('change', applyFilters);
    filterForm.addEventListener('reset', () => requestAnimationFrame(applyFilters));
  }
</script>
